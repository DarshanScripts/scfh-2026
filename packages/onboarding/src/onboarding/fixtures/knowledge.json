  "claims": [
    {
      "claimId": "guide-location",
      "text": "The Maintenance Intake Guide is in the Facilities onboarding folder.",
      "passageIds": [
        "guide-location"
      ]
    },
    {
      "claimId": "intake-requirements",
      "text": "Before logging a ticket, collect the building and room or location, an issue summary, and a callback channel.",
      "passageIds": [
        "intake-checklist"
      ]
    },
    {
      "claimId": "unassigned-escalation",
      "text": "If the ticket still has no owner at the end of the next business day after logging, send its ID and latest status to the Desk Lead.",
      "passageIds": [
        "unassigned-trigger",
        "unassigned-reminder"
      ]
    },
    {
      "claimId": "next-deadline",
      "text": "As of November 20, 2026, FM-104 is due first, on November 23 at noon Berlin time. The Desk Lead owns it and needs to confirm the access window with the site contact.",
      "passageIds": [
        "queue-as-of",
        "queue-fm-104"
      ]
    },
    {
      "claimId": "duplicate-tip",
      "text": "The Intake Coordinator recommends searching open tickets by building and room first, then comparing the issue summaries.",
      "passageIds": [
        "duplicate-check"
      ]
    },
    {
      "claimId": "current-routing",
      "text": "Assign new routine maintenance tickets to the Maintenance Queue.",
      "passageIds": [
        "queue-handoff"
      ]
    },
    {
      "claimId": "intake-backup",
      "text": "The Duty Intake Coordinator covers intake when the regular coordinator is away.",
      "passageIds": [
        "intake-backup"
      ]
    },
    {
      "claimId": "handoff-location",
      "text": "Store handoff notes in the Shift Handoffs folder.",
      "passageIds": [
        "handoff-location"
      ]
    },
    {
      "claimId": "folder-access",
      "text": "Ask the service desk for FM-Desk-Read membership, approved by the Desk Lead. Until access is granted, use the read-only onboarding copy and ask the Duty Intake Coordinator to attach new queue notes.",
      "passageIds": [
        "folder-access"
      ]
    },
    {
      "claimId": "access-booking",
      "text": "FM-104 is waiting for the Library site contact to confirm a staffed access window for service room B-012. The Desk Lead needs to confirm it by November 23 at noon before a repair visit can be booked.",
      "passageIds": [
        "access-booking"
      ]
    },
    {
      "claimId": "key-holder",
      "text": "The Library caretaker holds the key for FM-104. Check the latest portal note before confirming the tentative Monday 07:30-08:30 access window.",
      "passageIds": [
        "key-holder"
      ]
    }
  ],
