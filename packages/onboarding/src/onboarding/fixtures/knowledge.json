  "workflow": {
    "workflowId": "maintenance-intake",
    "title": "Log a routine maintenance request",
    "steps": [
      {
        "stepId": "check-details",
        "kind": "decision",
        "label": "Required details present?",
        "narration": "First, check for the building and room or location, a summary of the issue, and a callback channel.",
        "passageIds": [
          "intake-checklist"
        ],
        "edges": [
          {
            "label": "Missing",
            "toStepId": "request-details"
          },
          {
            "label": "Complete",
            "toStepId": "check-duplicate"
          }
        ]
      },
      {
        "stepId": "request-details",
        "kind": "exception",
        "label": "Ask for details and pause",
        "narration": "If any required detail is missing, ask the reporter for it and pause intake until you have it.",
        "passageIds": [
          "missing-details"
        ],
        "edges": []
      },
      {
        "stepId": "check-duplicate",
        "kind": "decision",
        "label": "Same issue already logged?",
        "narration": "Once the details are complete, check for a duplicate. Search open tickets by building and room first, then compare the issue summaries.",
        "passageIds": [
          "duplicate-check"
        ],
        "edges": [
          {
            "label": "Match",
            "toStepId": "link-duplicate"
          },
          {
            "label": "New issue",
            "toStepId": "log-ticket"
          }
        ]
      },
      {
        "stepId": "link-duplicate",
        "kind": "exception",
        "label": "Link the report and stop",
        "narration": "If an open ticket covers the same issue, link this report to that ticket and stop intake for the new report.",
        "passageIds": [
          "existing-ticket"
        ],
        "edges": []
      },
      {
        "stepId": "log-ticket",
        "kind": "action",
        "label": "Log a new ticket",
        "narration": "If there is no matching ticket, log a new routine maintenance ticket.",
        "passageIds": [
          "new-ticket"
        ],
        "edges": [
          {
            "label": "Ticket logged",
            "toStepId": "assign-queue"
          }
        ]
      },
      {
        "stepId": "assign-queue",
        "kind": "handoff",
        "label": "Assign to the Maintenance Queue",
        "narration": "Assign the new ticket to the Maintenance Queue so the next team can take it from there.",
        "passageIds": [
          "queue-handoff"
        ],
        "edges": [
          {
            "label": "Timing note",
            "toStepId": "callback-gap"
          }
        ]
      },
      {
        "stepId": "callback-gap",
        "kind": "gap",
        "label": "Vendor timing is undocumented",
        "narration": "The guide gives no vendor callback deadline. Confirm the timing with the Desk Lead.",
        "passageIds": [
          "vendor-callback-gap"
        ],
        "edges": []
      }
    ]
  }
}
