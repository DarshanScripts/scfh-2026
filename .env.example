LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ANTHROPIC_API_KEY=

# Absolute path to uvx.exe if it is not on PATH.
WINDOWS_MCP_UVX=
# Defaults to handbook-windows.
LIVEKIT_AGENT_NAME=
AGENT_LANGUAGE=en
# Transcribe English and German in the same call.
STT_LANGUAGE=multi
LLM_MODEL=claude-sonnet-5-5
REASONING_EFFORT=none
# Set to Enceladus to use Gemini speech via LiveKit Inference.
LIVEKIT_VOICE_ID=
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_VOICE_ID=

# Optional avatar
ENABLE_AVATAR=0
BEYOND_PRESENCE_API_KEY=
BEYOND_PRESENCE_AVATAR_ID=

# Optional Harbour mode and team-verified Google Drive folder link.
# ONBOARDING_KNOWLEDGE=harbour
HARBOUR_DRIVE_FOLDER_URL=
